# Reference of every environment variable the API reads. Documentation only - nothing loads this file automatically.
# On Render set them in: dialoo-api -> Environment.  Locally: export them (Mac/Linux) or $env:NAME="value" (PowerShell).

# ---- Database (MySQL 8) ----
# Local:
DB_URL=jdbc:mysql://localhost:3306/dialoo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
# Azure MySQL / any hosted MySQL (SSL required):
# DB_URL=jdbc:mysql://<server>.mysql.database.azure.com:3306/<database>?sslMode=REQUIRED&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=dialoo
DB_PASSWORD=replace-with-your-db-password      # required, no default
DB_POOL_SIZE=10                                # use 5 on the free Render instance

# ---- Security ----
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated browser origins allowed by CORS (no spaces, no trailing slash). Add the mobile app origins if you ship the app.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost

# ---- First SUPER_ADMIN (required in every environment, no built-in defaults) ----
ADMIN_PHONE=your-10-digit-admin-mobile
ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
ADMIN_NAME=Dialoo Admin
ADMIN_RESET_PASSWORD=false                     # true for ONE start only, to reset the admin password

# ---- OTP / SMS ----
OTP_DEV_MODE=true                              # true = OTP shown on screen (testing only). MUST be false for real users.
SMS_PROVIDER=log                               # log | msg91 | twilio
# MSG91 OTP Widget (customer OTP login, no DLT template needed on our side). Set all three to enable.
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_AUTH_KEY=                                # secret, server-side only
# MSG91 server SMS sender (only with SMS_PROVIDER=msg91, needs a DLT-approved OTP template containing ##OTP##)
MSG91_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Data / misc ----
FLYWAY_EXTRA_LOCATION=classpath:db/demo        # classpath:db/none in production = no demo providers

# ---- Google Maps Platform (server side) ----
# SERVER key: enable ONLY "Routes API" and "Geocoding API" on it; add an IP restriction if your host has a fixed egress IP.
# Never use this key in the web or mobile build. Without it: tracking still works with straight-line ETA estimates and
# reverse geocoding falls back to the cities/areas stored in our own database.
GOOGLE_MAPS_SERVER_API_KEY=
GEOCODE_DAILY_LIMIT=5000                       # hard caps per UTC day (counted in table maps_api_usage)
TRACKING_ROUTES_DAILY_LIMIT=3000
# ---- Live tracking tunables (defaults shown; every one is optional) ----
TRACKING_GPS_INTERVAL_SECONDS=10
TRACKING_STATIONARY_INTERVAL_SECONDS=30
TRACKING_MIN_DISTANCE_METERS=15
TRACKING_PERSIST_INTERVAL_SECONDS=60
TRACKING_STALE_SECONDS=30
TRACKING_UNAVAILABLE_SECONDS=90
TRACKING_ARRIVAL_RADIUS_METERS=100
TRACKING_ROUTES_REFRESH_SECONDS=300
TRACKING_ROUTE_DEVIATION_METERS=150
TRACKING_ROUTES_PREFERENCE=TRAFFIC_UNAWARE     # TRAFFIC_AWARE costs more per request
TRACKING_ROUTES_TRAVEL_MODE=DRIVE              # or TWO_WHEELER
TRACKING_HISTORY_RETENTION_DAYS=7
NEARBY_DEFAULT_RADIUS_KM=5
NEARBY_MAX_RADIUS_KM=20
AUTOCOMPLETE_DEBOUNCE_MILLIS=400
