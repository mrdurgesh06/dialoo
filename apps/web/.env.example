# Local development. Copy to apps/web/.env.local if you need to change it.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Maps BROWSER key: restrict to HTTP referrers (your web origins, and https://localhost/* for the Capacitor app) and to
# "Maps JavaScript API" + "Places API (New)". Leave empty to run without maps (everything else keeps working).
VITE_GOOGLE_MAPS_API_KEY=
# Cloud-based Map ID (Google Cloud Console > Map Management) - required for advanced markers. DEMO_MAP_ID works for development only.
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
