<?xml version="1.0" encoding="UTF-8"?>
<!-- Used by the Dockerfile (mvn -s settings.xml). Render's shared build IPs are sometimes rate limited (HTTP 429) by
     repo.maven.apache.org, so dependencies are downloaded from Google's public mirror of Maven Central instead. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google Maven Central mirror</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
